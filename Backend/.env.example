# Environment Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/posture_monitoring
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/posture_monitoring

# JWT Configuration
JWT_SECRET=2f8b7c1e-4e2a-4b7a-9c3d-8e2f7a1b2c3d
JWT_EXPIRE=7d

# CORS Configuration
FRONTEND_URL=http://localhost:5173

# Python Service Configuration
PYTHON_SERVICE_PORT=5001
PYTHON_EXECUTABLE=python

# Rate Limiting
MAX_REQUESTS_PER_WINDOW=100
WINDOW_MS=900000

# Session Configuration
SESSION_TIMEOUT_MINUTES=30

# Logging
LOG_LEVEL=info

# Email (SMTP) - required to enable daily report emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
MAIL_FROM="Posture Coach <no-reply@example.com>"

# Daily report scheduler
# Set to true to enable cron job that sends daily emails to all active users
ENABLE_DAILY_EMAILS=false
# Cron schedule (default: 0 18 * * * -> 6 PM server time)
DAILY_EMAIL_CRON=0 18 * * *

# Google OAuth (for Flask backend)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
FLASK_SECRET_KEY=your_flask_secret_key
